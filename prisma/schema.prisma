// Prisma schema for Central SSO BPVP (Identity Provider & Satellite Session Store)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Akun Pengguna SSO Terpusat
model User {
  id             String         @id @default(cuid())
  nama           String
  email          String         @unique
  password       String
  role           String         @default("user") // "admin" | "user"
  aktif          Boolean        @default(true)
  sessionToken   String?        @db.Text
  tokenExpiredAt DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  logAktivitas   LogAktivitas[]
}

// 2. Akun Pengguna Lokal Aplikasi Satelit (Skillhub, Maganghub, LSP, Keuangan, PTSP)
model SatelliteUser {
  id             String    @id @default(cuid())
  appId          String    // "skillhub" | "maganghub" | "lsp" | "keuangan" | "ptsp"
  email          String
  nama           String
  nip            String?
  role           String    @default("user")
  sessionToken   String?   @db.Text
  tokenExpiredAt DateTime?
  lastLoginAt    DateTime?
  aktif          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([appId, email])
  @@index([appId])
  @@index([email])
}

// 3. Log Audit Login & Autentikasi SSO
model LogAktivitas {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aksi        String   // "LOGIN" | "LOGOUT" | "REVOKE"
  entitas     String   // "User" | "SatelliteUser"
  entitasId   String
  deskripsi   String
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entitas])
  @@index([createdAt])
}

// 4. Registry Aplikasi Ekosistem BPVP yang Terdaftar di SSO
model Application {
  id          String   @id // "simpeg" | "skillhub" | "maganghub" | "lsp" | "keuangan" | "ptsp" | "absensi"
  nama        String
  deskripsi   String?
  kategori    String   // "Kepegawaian & SDM" | "Pelatihan Vokasi" | "Sertifikasi" | "Keuangan & Sarana" | "Pelayanan Publik" | dll
  url         String
  icon        String?  // Emoji / Icon SVG, misal: "👥", "🎓", "🏢", "⏱️"
  color       String?  // CSS gradient, misal: "from-blue-600 to-[#003399]"
  badge       String?  // "Aplikasi Utama" | null
  apiKey      String?  // Secret API Key untuk autentikasi M2M khusus
  aktif       Boolean  @default(true)
  urutan      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([aktif])
  @@index([urutan])
}

